generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  telegramId String @unique
  name String
  username String?
  createdAt DateTime? @default(now())
  lastSeenAt DateTime?
  activities UserActivity[]
  items Item[]
  collections Collection[]
  ownedSpaces Space[] @relation("SpaceOwner")
  personalSpace Space? @relation("PersonalSpace")
  memberships SpaceMember[]
  @@index([createdAt])
  @@index([lastSeenAt])
}
model UserActivity {
  userId String
  day DateTime @db.Date
  apiRequests Int @default(0)
  botMessages Int @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, day])
  @@index([day])
}
model Space {
  id String @id @default(cuid())
  name String
  theme String @default("sage")
  background Json @default("{\"pattern\":\"dots\",\"contrast\":42,\"scale\":\"small\"}")
  ownerId String
  owner User @relation("SpaceOwner", fields: [ownerId], references: [id])
  personalUserId String? @unique
  personalUser User? @relation("PersonalSpace", fields: [personalUserId], references: [id])
  members SpaceMember[]
  items Item[]
  collections Collection[]
  invites SpaceInvite[]
  statuses BookmarkStatus[]
  createdAt DateTime @default(now())
}
model BookmarkStatus {
  spaceId String
  key String
  name String
  color String
  position Int
  isDefault Boolean @default(false)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  items Item[]
  @@id([spaceId, key])
  @@unique([spaceId, name])
}
model SpaceMember {
  spaceId String
  userId String
  role String @default("editor")
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([spaceId, userId])
}
model SpaceInvite {
  id String @id @default(cuid())
  tokenHash String @unique
  spaceId String
  role String @default("viewer")
  expiresAt DateTime
  revokedAt DateTime?
  uses Int @default(0)
  maxUses Int @default(20)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
}
model Collection {
  id String @id @default(cuid())
  name String
  userId String
  user User @relation(fields: [userId], references: [id])
  spaceId String?
  space Space? @relation(fields: [spaceId], references: [id])
  rules Json?
  items Item[]
  entries ItemCollection[]
  @@unique([spaceId, name])
}
model ItemCollection {
  itemId String
  collectionId String
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  @@id([itemId, collectionId])
}
model Item {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  spaceId String?
  space Space? @relation(fields: [spaceId], references: [id])
  type String
  title String
  titleMode String @default("custom")
  text String @default("")
  url String?
  canonicalUrl String?
  source String @default("")
  sourceTitle String?
  sourceDescription String?
  author String?
  metadataStatus String @default("pending")
  metadataUpdatedAt DateTime?
  autoTags String[] @default([])
  dismissedAutoTags String[] @default([])
  tags String[] @default([])
  status String @default("saved")
  statusDefinition BookmarkStatus? @relation(fields: [spaceId, status], references: [spaceId, key], onDelete: Restrict, onUpdate: Cascade)
  embedding Float[] @default([])
  embeddingModel String?
  embeddingFingerprint String?
  collectionId String?
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  collections ItemCollection[]
  mediaKey String?
  mime String?
  telegramFileId String?
  telegramFileUniqueId String?
  telegramMediaKind String?
  telegramThumbnailFileId String?
  telegramFileSize BigInt?
  telegramMessageId String? @unique
  createdAt DateTime @default(now())
  @@unique([spaceId, canonicalUrl])
  @@index([userId, createdAt])
  @@index([spaceId, createdAt])
  @@index([spaceId, status])
  @@index([metadataStatus])
}
