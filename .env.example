DATABASE_URL=postgresql://save:save@localhost:5432/save
PORT=3000
HTTP_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
DEV_AUTH=true
BOT_POLLING=true
BOT_TOKEN=
# Bot username without @, required for Telegram invitation links.
BOT_USERNAME=
MINI_APP_URL=https://tucklyboard.ru
# Optional, only for reading old S3 cards. New files are stored in Telegram.
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=save
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# Background OpenGraph/oEmbed metadata and local topic tags (no social API keys).
ENRICHMENT_ENABLED=true
# Optional neural embeddings: Ollama /api/embed or OpenAI-compatible /v1/embeddings.
# Empty URL uses bilingual topic/synonym search; nothing is sent to a model.
EMBEDDINGS_URL=
EMBEDDINGS_MODEL=nomic-embed-text
EMBEDDINGS_API_KEY=
# Comma-separated numeric Telegram IDs. Empty means no administrator access.
# Admin routes always require signed Telegram Mini App initData, even with DEV_AUTH=true.
ADMIN_TELEGRAM_IDS=
