{
  "trailingComma": "all",
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "printWidth": 100,
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrder": [
    "<BUILTIN_MODULES>",
    "",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@tuckly/",
    "",
    "^\\.\\./",
    "",
    "^\\./"
  ],
  "importOrderTypeScriptVersion": "5.7.0",
  "overrides": [
    {
      "files": "apps/api/**/*.ts",
      "options": {
        "importOrderParserPlugins": ["typescript", "decorators-legacy"]
      }
    }
  ]
}
